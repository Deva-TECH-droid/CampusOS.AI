# Copy this file to `.env` in the same folder and fill in real values.
# `.env` is gitignored on purpose — never commit real secrets.

# ── Database ────────────────────────────────────────────────────────────
MONGO_URI=complete_your_mongodb_connection_string_here

# ── Server ──────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Auth (JWT) ──────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=addyour_long_random_string_here
JWT_REFRESH_SECRET=addyour_long_random_string_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── One-time superadmin seed (npm run seed:admin) ──────────────────────
ADMIN_EMAIL=adminmail@gmail.com
ADMIN_PASSWORD=*****
ADMIN_FIRST_NAME=firstname
ADMIN_LAST_NAME=lastname

# ── File uploads (Cloudinary) ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Redis (not wired up yet — config/redis.js is a stub, safe to leave blank) ──
REDIS_URL=

# ── Outbound email (email.service.js) ──────────────────────────────────
# Leave blank in development — falls back to logging to the console
# instead of failing when SMTP isn't configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Campus Assistant chatbot internal API layer ─────────────────────────
INTERNAL_CHATBOT_SECRET=pick_a_long_random_string_here